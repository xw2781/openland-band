  "lines": [
    {
      "t": 24.42,
      "text": "照片泛黄 旧歌弹响",
      "te": 30.72,
      "tr": {
        "en": "The photographs have yellowed, an old song rings out",
        "ja": "写真は色あせ、古い歌が響く",
        "ko": "사진은 바래고, 옛 노래가 울린다"
      }
    },
    {
      "t": 30.72,
      "text": "是我们 绚烂的 过往",
      "te": 36.7,
      "tr": {
        "en": "It is our brilliant past",
        "ja": "あれは僕たちの、絢爛とした過ぎし日",
        "ko": "그것은 우리의 찬란했던 지난날"
      }
    },
    {
      "break": true
    },
    {
      "t": 38.02,
      "text": "人来人往 聚散无常",
      "te": 44.22,
      "tr": {
        "en": "People come and go; meeting and parting have no certainty",
        "ja": "人は来ては去り、出会いと別れは常なきもの",
        "ko": "사람들은 오고 가고, 만남과 이별은 덧없다"
      }
    },
    {
      "t": 44.22,
      "text": "是生活 无奈的 走向",
      "te": 49.5,
      "tr": {
        "en": "That is the helpless way life goes",
        "ja": "それが暮らしの、抗えない行方",
        "ko": "그것이 삶의 어쩔 수 없는 방향"
      }
    },
    {
      "break": true
    },
    {
      "t": 50.72,
      "text": "人 生 是场流浪",
      "te": 54.88,
      "tr": {
        "en": "Life is a wandering",
        "ja": "人生は流浪の旅",
        "ko": "인생은 떠돎의 여정"
      }
    },
    {
      "t": 54.88,
      "text": "没 人 总守望",
      "te": 58.04,
      "tr": {
        "en": "No one keeps watch forever",
        "ja": "誰もずっと見守ってはくれない",
        "ko": "언제나 지켜봐 주는 사람은 없다"
      }
    },
    {
      "t": 58.04,
      "text": "无奈的幻想",
      "te": 61.08,
      "tr": {
        "en": "Helpless fantasies",
        "ja": "なすすべのない幻想",
        "ko": "어쩔 수 없는 환상"
      }
    },
    {
      "break": true
    },
    {
      "t": 63.34,
      "text": "离 别 难免惆怅",
      "te": 67.58,
      "tr": {
        "en": "Parting can’t help but bring melancholy",
        "ja": "別れには寂しさがつきもの",
        "ko": "이별에는 서글픔이 따르기 마련"
      }
    },
    {
      "t": 67.58,
      "text": "就 让 这时光",
      "te": 70.82,
      "tr": {
        "en": "Then just let this time",
        "ja": "どうか、この時を",
        "ko": "그저 이 시간을"
      }
    },
    {
      "t": 70.82,
      "text": "轻轻的原谅",
      "te": 73.88,
      "tr": {
        "en": "Forgive us, gently",
        "ja": "そっと許してほしい",
        "ko": "부드럽게 용서하게 두자"
      }
    },
    {
      "break": true
    },
