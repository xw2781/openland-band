    {
      "t": 173.82,
      "text": "Though nights so long",
      "te": 177.24,
      "tr": {
        "zh": "纵使夜那么长",
        "ja": "夜がどれほど長くても",
        "ko": "밤이 아무리 길어도"
      }
    },
    {
      "t": 177.24,
      "text": "And days so cold",
      "te": 179.96,
      "tr": {
        "zh": "日子那么冷",
        "ja": "昼がどれほど冷たくても",
        "ko": "낮이 아무리 차가워도"
      }
    },
    {
      "t": 180.4,
      "text": "I'll be right here",
      "te": 182.68,
      "tr": {
        "zh": "我都会在这里",
        "ja": "ここにいるよ",
        "ko": "난 여기 있을게"
      }
    },
    {
      "t": 182.74,
      "text": "You'll always know",
      "te": 185.2,
      "tr": {
        "zh": "你会一直知道",
        "ja": "君はいつだって知っているはず",
        "ko": "너는 언제나 알 거야"
      }
    },
    {
      "break": true
    },
    {
      "t": 185.2,
      "text": "Like rivers flow",
      "te": 187.9,
      "tr": {
        "zh": "如同江河流向",
        "ja": "川が流れるように",
        "ko": "강물이 흐르듯"
      }
    },
    {
      "t": 187.9,
      "text": "To seas below",
      "te": 190.54,
      "tr": {
        "zh": "汇入下方的海",
        "ja": "下の海へと",
        "ko": "아래 바다로 가듯"
      }
    },
    {
      "t": 190.54,
      "text": "My love won't fade",
      "te": 193.46,
      "tr": {
        "zh": "我的爱不会褪去",
        "ja": "僕の愛は色あせない",
        "ko": "내 사랑은 사그라지지 않고"
      }
    },
