{
  "id": "waiting",
  "title": "Waiting For You",
  "lang": "en",
  "placeholder": false,
  "source": "audio/lyrics/waiting-for-you.txt",
  "audio": "audio/waiting-for-you.m4a",
  "note": "Official lyrics. Timing aligned to the studio master (faster-whisper large-v3). Intro is instrumental until ~0:20. Line 2 (\"Midnight talks…\") sits in a clear slot that the recognizer mis-heard; time kept from that slot. The five closing repeats were checked against the vocal energy contour (the recognizer only marked two and hallucinated a credit at the fade). Translations are editorial, not official.",
  "lines": [
    {
      "t": 20.48,
      "text": "City lights keep fading slow",
      "te": 25.14,
      "tr": {
        "zh": "城市的灯火慢慢褪去",
        "ja": "街の灯がゆっくりと消えていく",
        "ko": "도시의 불빛이 천천히 사그라든다"
      }
    },
    {
      "t": 25.14,
      "text": "Midnight talks we used to know",
      "te": 29.98,
      "tr": {
        "zh": "那些我们曾熟悉的深夜长谈",
        "ja": "あの頃の、真夜中の会話",
        "ko": "우리가 알던 한밤의 이야기"
      }
    },
    {
      "t": 29.98,
      "text": "Every street just calls your name",
      "te": 36.5,
      "tr": {
        "zh": "每条街都在唤着你的名字",
        "ja": "どの通りも君の名前を呼ぶ",
        "ko": "모든 거리가 네 이름을 부른다"
      }
    },
    {
      "t": 36.8,
      "text": "But nothing feels like the same",
      "te": 41.06,
      "tr": {
        "zh": "可一切都和从前不一样了",
        "ja": "でも何もかもが、もう同じじゃない",
        "ko": "하지만 아무것도 예전 같지 않아"
      }
    },
    {
      "break": true
    },
    {
      "t": 42.56,
      "text": "Moonlight spills across my room",
      "te": 46.96,
      "tr": {
        "zh": "月光铺满我的房间",
        "ja": "月明かりが部屋いっぱいにこぼれ",
        "ko": "달빛이 내 방을 가득 채운다"
      }
    },
    {
      "t": 47.36,
      "text": "Counting stars to clear my mind",
      "te": 52.66,
      "tr": {
        "zh": "数着星星，好让心里平静",
        "ja": "星を数えて、心を澄ませる",
        "ko": "별을 세며 마음을 비운다"
      }
    },
    {
      "t": 52.66,
      "text": "Every beat inside my chest",
      "te": 58.36,
      "tr": {
        "zh": "胸腔里的每一次心跳",
        "ja": "胸の奥の、ひとつひとつの鼓動",
        "ko": "가슴속 모든 박동이"
      }
    },
    {
      "t": 58.48,
      "text": "Still knows you are my best",
      "te": 62.84,
      "tr": {
        "zh": "仍知道，你是我最珍贵的人",
        "ja": "今も知っている、君が一番だと",
        "ko": "여전히 알지, 네가 나의 전부라는 걸"
      }
    },
    {
      "break": true
    },
    {
      "t": 63.4,
      "text": "I am waiting for you",
      "te": 66.56,
      "tr": {
        "zh": "我在等你",
        "ja": "君を待っている",
        "ko": "너를 기다리고 있어"
      }
    },
    {
      "t": 66.7,
      "text": "My love",
      "te": 67.92,
      "tr": {
        "zh": "我的爱",
        "ja": "愛しい人",
        "ko": "나의 사랑"
      }
    },
    {
      "t": 68.72,
      "text": "I'm always here and",
      "te": 70.7,
      "tr": {
        "zh": "我一直都在，",
        "ja": "いつでもここにいる、",
        "ko": "나는 언제나 여기 있어,"
      }
    },
    {
      "t": 70.7,
      "text": "Waiting for you",
      "te": 72.06,
      "tr": {
        "zh": "等着你",
        "ja": "君を待っている",
        "ko": "너를 기다리고 있어"
      }
    },
    {
      "t": 72.06,
      "text": "Come back",
      "te": 73.46,
      "tr": {
        "zh": "回来吧",
        "ja": "戻ってきて",
        "ko": "돌아와 줘"
      }
    },
    {
      "t": 73.64,
      "text": "Through days and nights",
      "te": 75.82,
      "tr": {
        "zh": "走过多少昼夜",
        "ja": "昼も夜も",
        "ko": "낮과 밤을 지나"
      }
    },
    {
      "t": 75.82,
      "text": "I am waiting for you",
      "te": 77.5,
      "tr": {
        "zh": "我在等你",
        "ja": "君を待っている",
        "ko": "너를 기다리고 있어"
      }
    },
    {
      "t": 77.62,
      "text": "It's time",
      "te": 78.8,
      "tr": {
        "zh": "是时候了",
        "ja": "もうその時だ",
        "ko": "이제는 때야"
      }
    },
    {
      "t": 78.8,
      "text": "I keep you in my heart",
      "te": 82.22,
      "tr": {
        "zh": "我把你放在心里",
        "ja": "心の中に君を留めて",
        "ko": "마음에 너를 품고"
      }
    },
    {
      "t": 82.22,
      "text": "To hold to love",
      "te": 84.44,
      "tr": {
        "zh": "紧握这份爱",
        "ja": "この愛を、抱きしめて",
        "ko": "이 사랑을 붙잡고"
      }
    },
